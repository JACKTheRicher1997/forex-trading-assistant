# ============================================
# Forex Trading Assistant & Alert System
# ตัวอย่างไฟล์ .env (คัดลอกเป็น .env แล้วใส่ค่าของคุณ)
# ============================================

# สัญลักษณ์และ Timeframe เริ่มต้น
# รองรับ: XAUUSDm (ทอง), EURUSD, GBPUSD, USDJPY, BTCUSD ฯลฯ
SYMBOL=XAUUSDm
TIMEFRAME=M5

# ค่าความยาวเส้น EMA
EMA_FAST=50
EMA_SLOW=150

# การตั้งค่าแจ้งเตือน LINE
# รองรับทั้ง LINE Messaging API (แนะนำ) และ LINE Notify
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_USER_ID=your_user_id
LINE_NOTIFY_TOKEN=your_line_notify_token_if_any

# การตั้งค่าสรุปข่าว ForexFactory
TIMEZONE=Asia/Bangkok
WEEKLY_ALERT_DAY=monday
WEEKLY_ALERT_TIME=06:30
# สกุลเงินที่ต้องการแจ้งเตือนใน LINE (คั่นด้วย , เช่น USD,EUR หรือ ใส่ ALL เพื่อรับทุกสกุล)
# ค่าเริ่มต้น: USD (เฉพาะข่าวดอลลาร์เท่านั้น)
WEEKLY_ALERT_CURRENCIES=USD
POLL_INTERVAL_SECONDS=30

# คำเตือนห้ามเทรดช่วงเริ่ม London Session (เฉพาะวันที่มีข่าวสีแดง)
# ระบบจะแจ้งเตือน LINE ตอนเวลา LONDON_ALERT_TIME ว่าตลาดจะ Sideway จนข่าวจริงออก
# ให้หยุดเทรดและรอข่าวจริงก่อนค่อยเข้า (โอกาสแพ้สูงมากช่วงก่อนข่าว)
LONDON_ALERT_ENABLED=true
LONDON_ALERT_TIME=14:00

# แจ้งเตือนผลข่าวจริง (Actual) หลังข่าวแดงออกแล้ว delay นาที
# เช่น ข่าวออก 19:30 -> ส่ง LINE ตอน 19:35 (แสดงค่าจริง/คาดการณ์/ก่อนหน้า)
# สีของค่าจริง: สีเขียว (ดีกว่าคาด) / สีแดง (แย่กว่าคาด) / สีเทา (ปกติ)
NEWS_RELEASE_ALERT_ENABLED=true
NEWS_RELEASE_ALERT_DELAY_MINUTES=5
